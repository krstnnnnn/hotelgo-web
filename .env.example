# Address of the HOTELGO API (your Render API URL + /api). Used when you run: npm run build / npm run dev
# Never put passwords or secrets here: everything in a React app is visible to the public.
API_URL=http://localhost:8000/api

# The SECRET address of the staff sign-in: one word of 8+ letters/numbers (- and _ allowed). Not linked anywhere.
# Staff open  https://YOUR-SITE.onrender.com/#/<this word>. Leave empty to switch the staff sign-in off.
STAFF_PATH=door-local-7k3m
